# Atlas Talents - Environment Configuration
# Copiez ce fichier en .env et adaptez les valeurs

APP_ENV=production
APP_URL=http://localhost/atlas-talents
APP_DEBUG=0

# Demo mode - À activer uniquement en local/développement
APP_ALLOW_DEMO_MODE=0
APP_DEMO_ACCESS_SECRET=

# Inscriptions publiques autorisées (teacher,manager,recruiter,coach)
APP_ALLOWED_PUBLIC_REGISTRATION_ROLES=teacher

# Stockage (optionnel - chemin absolu hors webroot)
APP_STORAGE_ROOT=

# Base de données
DB_HOST=localhost
DB_NAME=atlas_talents
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# OpenAI API (optionnel - analyse IA avancée)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_URL=https://api.openai.com/v1/responses
OPENAI_TIMEOUT=90
AI_ALLOW_DEMO_FALLBACK=1